# ==============================================================================
# TheSSBuddy WMS Enterprise - Environment Configuration
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=production

# JWT Authentication Secret
JWT_SECRET=wms_enterprise_secret_jwt_key_2026

# Database Type: MYSQL | SQLITE | MSSQL | POSTGRES
DB_TYPE=MYSQL

# MySQL Configuration (cPanel / Localhost)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wms_enterprise_db
DB_USER=root
DB_PASSWORD=

# SQLite Configuration (Fallback)
SQLITE_DB_PATH=data/wms_enterprise.db

